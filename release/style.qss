QMainWindow {
    background-color: #1e1e1e;
}

QPushButton {
    background-color: #2b2b2b;
    color: white;
    border-radius: 8px;
    padding: 10px 16px;
}

QPushButton:hover {
    background-color: #3a3a3a;
}

QTextEdit {
    background-color: #2b2b2b;
    color: white;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
}

QFrame#qrFrame {
    border: 2px dashed #3a3a3a;
    border-radius: 12px;
}

QPushButton#menuButton {
    background: transparent;
    border: none;
}

/* === САЙДБАР === */
QFrame#sideBar {
    background-color: #1f1f1f;   /* почти как окно */
    border: none;                /* УБРАЛИ границу */
}

/* === КНОПКИ В САЙДБАРЕ === */
QFrame#sideBar QPushButton {
    background-color: transparent;
    color: #cfcfcf;
    text-align: center;
    padding: 14px 0;
    border: none;
    font-size: 15px;
}

/* hover — очень мягкий */
QFrame#sideBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* active */
QFrame#sideBar QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}
